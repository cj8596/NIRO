rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isCouple() { return signedIn() && role() == 'couple'; }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false; // Assign roles manually in Firebase Console.
    }
    match /albums/{albumId} {
      allow read: if isCouple() || (signedIn() && resource.data.visibility == 'guest');
      allow create: if isCouple()
        && request.resource.data.visibility in ['guest', 'couple']
        && request.resource.data.title is string;
      allow update, delete: if isCouple();
    }
  }
}
